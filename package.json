{
  "name": "123pan-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -C apps/desktop dev",
    "start": "pnpm -C apps/desktop start",
    "build": "pnpm -C apps/desktop build",
    "typecheck": "pnpm -C apps/desktop typecheck",
    "lint": "eslint --cache .",
    "format": "prettier --write .",
    "build:sdk": "pnpm --filter @123pan/api-sdk build",
    "build:unpack": "pnpm -C apps/desktop build:unpack",
    "build:win": "pnpm -C apps/desktop build:win",
    "build:mac": "pnpm -C apps/desktop build:mac",
    "build:linux": "pnpm -C apps/desktop build:linux"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
