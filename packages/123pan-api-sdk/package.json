{
  "name": "@sharef/123pan-sdk",
  "version": "1.0.4",
  "description": "123Pan 普通用户 API Node.js SDK - 提供完整的 TypeScript 类型支持",
  "private": false,
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./bundle": {
      "import": "./dist/bundle.esm.js",
      "require": "./dist/bundle.cjs",
      "browser": "./dist/bundle.umd.js",
      "types": "./dist/bundle.d.ts"
    },
    "./core": {
      "import": "./dist/modules/core.esm.js",
      "require": "./dist/modules/core.cjs",
      "types": "./dist/modules/core.d.ts"
    },
    "./file": {
      "import": "./dist/modules/file.esm.js",
      "require": "./dist/modules/file.cjs",
      "types": "./dist/modules/file.d.ts"
    },
    "./offline": {
      "import": "./dist/modules/offline.esm.js",
      "require": "./dist/modules/offline.cjs",
      "types": "./dist/modules/offline.d.ts"
    },
    "./user": {
      "import": "./dist/modules/user.esm.js",
      "require": "./dist/modules/user.cjs",
      "types": "./dist/modules/user.d.ts"
    },
    "./direct-link": {
      "import": "./dist/modules/direct-link.esm.js",
      "require": "./dist/modules/direct-link.cjs",
      "types": "./dist/modules/direct-link.d.ts"
    },
    "./image": {
      "import": "./dist/modules/image.esm.js",
      "require": "./dist/modules/image.cjs",
      "types": "./dist/modules/image.d.ts"
    },
    "./video": {
      "import": "./dist/modules/video.esm.js",
      "require": "./dist/modules/video.cjs",
      "types": "./dist/modules/video.d.ts"
    }
  },
  "scripts": {
    "build": "pnpm run clean && rolldown -c && node scripts/normalize-dts.mjs",
    "dev": "rolldown -c -w",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint packages --ext .ts,.tsx",
    "lint:fix": "eslint packages --ext .ts,.tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "P123_LIVE_TEST=1 vitest run",
    "examples": "pnpm --filter @123pan/examples test",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "123pan",
    "api",
    "sdk",
    "typescript",
    "cloud-storage",
    "file-upload",
    "image-hosting",
    "video-transcode",
    "offline-download",
    "nodejs",
    "123云盘"
  ],
  "author": {
    "name": "sharef",
    "email": "sharef@163.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.9.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "rolldown": "^1.2.6",
    "rolldown-plugin-dts": "^0.28.3",
    "ts-node": "^10.9.2",
    "tslib": "^2.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@123pan/core": "workspace:*",
    "@123pan/direct-link": "workspace:*",
    "@123pan/file": "workspace:*",
    "@123pan/image": "workspace:*",
    "@123pan/offline": "workspace:*",
    "@123pan/user": "workspace:*",
    "@123pan/video": "workspace:*",
    "axios": "^1.6.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shijf/123pan-api-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/shijf/123pan-api-sdk/issues"
  },
  "homepage": "https://blog.sharef.top/123pan-api-sdk/"
}
